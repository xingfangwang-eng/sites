        <p>&copy; 2024 CryptoAgent Guard. 所有计算均在本地完成，您的私钥永远不会离开您的设备。</p>
        <p>支持网络: Ethereum | BSC | Solana | Polygon | Arbitrum</p>
    </footer>

    <script>
        const inputData = document.getElementById('input-data');
        const scoreDisplay = document.querySelector('.score-display');
        const scoreStatus = document.querySelector('.score-status');
        const statusIcons = document.querySelectorAll('.status-icon');
        const riskItems = document.querySelectorAll('.risk-checklist li');
        const gasValues = document.querySelectorAll('.gas-value');
        const auditPanel = document.querySelector('.audit-panel');
        const btnAudit = document.getElementById('btn-audit');
        const btnReset = document.getElementById('btn-reset');
        const btnCopy = document.getElementById('btn-copy');
        const btnSnapshot = document.getElementById('btn-snapshot');
        const messageArea = document.getElementById('message-area');
        
        let lastAuditResult = null;

        const GAS_DATA = {
            ethereum: {
                transfer: 21000,
                swap: 150000,
                approve: 50000,
                contract_deployment: 400000,
                average_gwei: 30,
                gwei_to_wei: 1000000000,
                wei_to_eth: 1000000000000000000
            },
            solana: {
                transfer: 5000,
                swap: 20000,
                approve: 10000,
                contract_deployment: 140000,
                average_lamports_per_signature: 5000,
                lamports_to_sol: 1000000000
            },
            bsc: {
                transfer: 21000,
                swap: 120000,
                approve: 45000,
                contract_deployment: 350000,
                average_gwei: 5,
                gwei_to_wei: 1000000000,
                wei_to_bnb: 1000000000000000000
            }
        };

        const RISK_PATTERNS = {
            high_risk_functions: [
                /approve\(/gi,
                /transferFrom\(/gi,
                /setApprovalForAll\(/gi,
                /increaseAllowance\(/gi,
                /decreaseAllowance\(/gi,
                /safeTransferFrom\(/gi
            ],
            zero_address: /0x0{40}/gi,
            blackhole_addresses: [
                '0x0000000000000000000000000000000000000000',
                '0x000000000000000000000000000000000000dead',
                '0x0000000000000000000000000000000000000001'
            ],
            phishing_patterns: [
                /0x[a-f0-9]{36}dead/gi,
                /0x[a-f0-9]{36}beef/gi,
                /0x[a-f0-9]{36}cafe/gi
            ],
            slippage: {
                pattern: /slippage\s*[=:]\s*(\d+\.?\d*)/gi,
                warning_threshold: 5
            }
        };

        const CHAIN_CONFIG = {
            ethereum: {
                name: 'Ethereum',
                chainId: 1,
                address_pattern: /^0x[a-f0-9]{40}$/i,
                decimals: 18
            },
            solana: {
                name: 'Solana',
                chainId: 101,
                address_pattern: /^[1-9A-HJ-NP-Za-km-z]{32,44}$/,
                decimals: 9
            },
            bsc: {
                name: 'Binance Smart Chain',
                chainId: 56,
                address_pattern: /^0x[a-f0-9]{40}$/i,
                decimals: 18
            },
            polygon: {
                name: 'Polygon',
                chainId: 137,
                address_pattern: /^0x[a-f0-9]{40}$/i,
                decimals: 18
            },
            arbitrum: {
                name: 'Arbitrum',
                chainId: 42161,
                address_pattern: /^0x[a-f0-9]{40}$/i,
                decimals: 18
            }
        };

        const KNOWN_PROTOCOLS = [
            '0x1f9840a85d5af5bf1d1762f925bdaddc4201f984',
            '0x7a250d5630b4cf539739df2c5dacb4c659f2488d',
            '0xd9e1cE17f2641f24aE83637ab66a2cca9C378B9F',
            '0x6b175474e89094c44da98b954eedeac495271d0f',
            '0x2a65Aca4D5fC5B5C859090a6c34d164135398226',
            '0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2',
            '0xBE0eB53F46cd790Cd13851d5EFf43D12404d33E8',
            '0x967da4048cD07aB37855c090aAF366e4ce1b9F48'
        ];

        function parseInput(input) {
            let result = {
                type: null,
                data: null,
                addresses: [],
                value: null,
                chain: 'ethereum',
                isValid: false
            };

            try {
                const jsonData = JSON.parse(input);
                result.type = 'json';
                result.data = jsonData;
                
                if (jsonData.to) {
                    result.addresses.push(jsonData.to);
                }
                if (jsonData.from) {
                    result.addresses.push(jsonData.from);
                }
                if (jsonData.value) {
                    result.value = jsonData.value;
                }
                if (jsonData.chainId) {
                    result.chain = getChainByChainId(jsonData.chainId);
                }
                
                result.isValid = result.addresses.length > 0 || jsonData.data || jsonData.to;
                return result;
            } catch {
                result.type = 'text';
                
                const ethAddressRegex = /0x[a-f0-9]{40}/gi;
                const solAddressRegex = /[1-9A-HJ-NP-Za-km-z]{32,44}/g;
                const valueRegex = /(\d+\.?\d*)\s*(ETH|BNB|SOL|wei|gwei)/gi;
                const functionRegex = /\b(approve|transferFrom|swap|transfer)\b/gi;
                
                let match;
                while ((match = ethAddressRegex.exec(input)) !== null) {
                    result.addresses.push(match[0]);
                }
                while ((match = solAddressRegex.exec(input)) !== null) {
                    result.addresses.push(match[0]);
                }
                while ((match = valueRegex.exec(input)) !== null) {
                    result.value = match[1] + ' ' + match[2];
                }
                
                result.isValid = result.addresses.length > 0 || functionRegex.test(input);
                return result;
            }
        }

        function getChainByChainId(chainId) {
            for (const [chain, config] of Object.entries(CHAIN_CONFIG)) {
                if (config.chainId === chainId) {
                    return chain;
                }
            }
            return 'ethereum';
        }

        function validateAddress(address, chain) {
            const config = CHAIN_CONFIG[chain] || CHAIN_CONFIG.ethereum;
            return config.address_pattern.test(address.toLowerCase());
        }

        function detectHighRiskFunctions(input) {
            const findings = [];
            for (const pattern of RISK_PATTERNS.high_risk_functions) {
                if (pattern.test(input)) {
                    findings.push(pattern.toString().replace(/\/[gim]*$/, ''));
                }
            }
            return findings;
        }

        function checkBlackholeAddress(address) {
            const lowerAddr = address.toLowerCase();
            return RISK_PATTERNS.blackhole_addresses.includes(lowerAddr);
        }

        function checkPhishingPattern(address) {
            for (const pattern of RISK_PATTERNS.phishing_patterns) {
                if (pattern.test(address)) {
                    return true;
                }
            }
            return false;
        }

        function checkSlippage(input) {
            const match = RISK_PATTERNS.slippage.pattern.exec(input);
            if (match) {
                const slippage = parseFloat(match[1]);
                if (slippage > RISK_PATTERNS.slippage.warning_threshold) {
                    return slippage;
                }
            }
            return null;
        }

        function isKnownProtocol(address) {
            return KNOWN_PROTOCOLS.includes(address.toLowerCase());
        }

        function calculateGasEstimate(chain, input) {
            const gasConfig = GAS_DATA[chain] || GAS_DATA.ethereum;
            let gasUsed = gasConfig.transfer;
            let operation = 'Transfer';
            
            if (input.includes('swap') || input.includes('Swap')) {
                gasUsed = gasConfig.swap;
                operation = 'Swap';
            } else if (detectHighRiskFunctions(input).length > 0) {
                gasUsed = gasConfig.approve;
                operation = 'Approve';
            } else if (input.includes('deploy') || input.includes('create')) {
                gasUsed = gasConfig.contract_deployment;
                operation = 'Contract Deployment';
            }
            
            let estimate = {
                gas: gasUsed,
                price: null,
                total: null,
                operation: operation
            };
            
            if (chain === 'solana') {
                estimate.price = '0.000005 SOL';
                estimate.total = (gasUsed * gasConfig.average_lamports_per_signature / gasConfig.lamports_to_sol).toFixed(6) + ' SOL';
            } else {
                estimate.price = gasConfig.average_gwei + ' Gwei';
                const totalWei = gasUsed * gasConfig.average_gwei * gasConfig.gwei_to_wei;
                estimate.total = (totalWei / gasConfig.wei_to_eth).toFixed(8) + ' ETH';
            }
            
            return estimate;
        }

        function auditTransaction(input) {
            const result = {
                score: 100,
                status: 'SAFE',
                statusText: '安全',
                checks: [
                    { name: '合约地址验证', status: 'safe', message: '' },
                    { name: '交易金额检查', status: 'safe', message: '' },
                    { name: '授权限额审查', status: 'safe', message: '' },
                    { name: '重入攻击检测', status: 'safe', message: '' },
                    { name: '合约交互白名单', status: 'safe', message: '' }
                ],
                gas: null,
                warnings: [],
                recommendations: [],
                hasExtremeRisk: false,
                extremeRiskReason: ''
            };

            const parsed = parseInput(input);
            
            if (!parsed.isValid) {
                result.score = 0;
                result.status = 'ERROR';
                result.statusText = '格式无法解析';
                return result;
            }

            result.gas = calculateGasEstimate(parsed.chain, input);

            const highRiskFunctions = detectHighRiskFunctions(input);
            if (highRiskFunctions.length > 0) {
                result.checks[2].status = 'warning';
                result.checks[2].message = '检测到高风险函数: ' + highRiskFunctions.join(', ');
                result.score -= 20;
                result.recommendations.push('建议: 确认授权目标地址是否为可信协议');
                
                if (highRiskFunctions.some(f => f.includes('setApprovalForAll'))) {
                    result.hasExtremeRisk = true;
                    result.extremeRiskReason = '检测到极端危险操作: setApprovalForAll';
                    result.warnings.push('【极端危险】检测到 setApprovalForAll 操作，这将允许合约控制您的所有 NFT 资产');
                    result.recommendations.push('紧急: 立即停止此操作！setApprovalForAll 会授权合约转移您的所有 NFT');
                    result.score -= 20;
                }
                
                for (const addr of parsed.addresses) {
                    if (!isKnownProtocol(addr)) {
                        result.checks[2].status = 'danger';
                        result.checks[2].message = '警告: approve 目标地址不是已知协议合约，存在极高风险';
                        result.warnings.push('极高风险: 授权给未知地址');
                        result.score -= 30;
                        result.recommendations.push('紧急: 停止此操作，核实目标地址真实性');
                        break;
                    }
                }
            }

            for (const addr of parsed.addresses) {
                if (!validateAddress(addr, parsed.chain)) {
                    result.checks[0].status = 'warning';
                    result.checks[0].message = '地址格式无效: ' + addr;
                    result.score -= 15;
                    result.recommendations.push('建议: 检查地址格式是否正确');
                }
                
                if (checkBlackholeAddress(addr)) {
                    result.checks[0].status = 'danger';
                    result.checks[0].message = '检测到黑洞地址: ' + addr;
                    result.warnings.push('极高风险: 目标地址是黑洞地址');
                    result.score -= 40;
                    result.recommendations.push('紧急: 此地址会永久锁定资产，请勿交易');
                }
                
                if (checkPhishingPattern(addr)) {
                    result.checks[0].status = 'danger';
                    result.checks[0].message = '检测到疑似钓鱼地址: ' + addr;
                    result.warnings.push('高风险: 地址符合钓鱼特征');
                    result.score -= 30;
                    result.recommendations.push('紧急: 验证合约地址是否来自官方渠道');
                }
            }

            if (parsed.value) {
                let valueNum = parseFloat(parsed.value);
                if (!isNaN(valueNum) && valueNum >= 10) {
                    result.checks[1].status = 'warning';
                    result.checks[1].message = '大额资产移动预警: ' + parsed.value;
                    result.warnings.push('大额资产移动预警: 超过 10 ETH');
                    result.score -= 15;
                    result.recommendations.push('建议: 再次确认交易金额是否正确');
                }
                
                if (valueNum >= 100) {
                    result.checks[1].status = 'danger';
                    result.checks[1].message = '极高风险: 大额资产转移超过 100 ETH';
                    result.warnings.push('极高风险: 大额资产转移');
                    result.score -= 20;
                    result.recommendations.push('紧急: 启用多重签名或延迟执行');
                }
            }

            const slippage = checkSlippage(input);
            if (slippage !== null) {
                result.checks[3].status = 'warning';
                result.checks[3].message = '滑点预警: ' + slippage + '%';
                result.warnings.push('滑点预警: 设置超过 5%');
                result.score -= 10;
                result.recommendations.push('建议: 降低滑点设置以减少损失风险');
            }

            for (const addr of parsed.addresses) {
                if (!isKnownProtocol(addr)) {
                    result.checks[4].status = 'warning';
                    result.checks[4].message = '未知合约地址: ' + addr;
                    result.score -= 10;
                    result.recommendations.push('建议: 通过官方渠道核实合约地址');
                }
            }

            result.score = Math.max(0, result.score);
            
            if (result.score >= 80) {
                result.status = 'SAFE';
                result.statusText = '安全';
            } else if (result.score >= 60) {
                result.status = 'WARNING';
                result.statusText = '中等风险';
            } else if (result.score >= 40) {
                result.status = 'HIGH RISK';
                result.statusText = '高风险';
            } else {
                result.status = 'CRITICAL';
                result.statusText = '极高风险';
            }

            return result;
        }

        function showMessage(message, type) {
            messageArea.innerHTML = '';
            const div = document.createElement('div');
            div.className = type === 'error' ? 'error-message' : 'success-message';
            div.textContent = message;
            messageArea.appendChild(div);
            setTimeout(() => {
                messageArea.innerHTML = '';
            }, 5000);
        }

        function generateAuditReport(result) {
            let report = `=== CryptoAgent Guard 审计报告 ===\n\n`;
            report += `交易类型: ${result.gas ? result.gas.operation : '未知'}\n`;
            report += `审计状态: ${result.status} (${result.statusText})\n`;
            report += `安全评分: ${result.score}/100\n\n`;
            
            report += `--- 风险检测结果 ---\n`;
            result.checks.forEach(check => {
                const statusIcon = check.status === 'safe' ? '[OK]' : check.status === 'warning' ? '[WARN]' : '[DANGER]';
                report += `${statusIcon} ${check.name}: ${check.message || '通过'}\n`;
            });
            
            if (result.warnings.length > 0) {
                report += `\n--- 风险警告 ---\n`;
                result.warnings.forEach(warning => {
                    report += `! ${warning}\n`;
                });
            }
            
            if (result.recommendations.length > 0) {
                report += `\n--- 安全建议 ---\n`;
                result.recommendations.forEach(rec => {
                    report += `> ${rec}\n`;
                });
            }
            
            if (result.gas) {
                report += `\n--- Gas 预估 ---\n`;
                report += `预估 Gas: ${result.gas.gas.toLocaleString()}\n`;
                report += `Gas 价格: ${result.gas.price}\n`;
                report += `总费用: ${result.gas.total}\n`;
            }
            
            report += `\n=== 报告结束 ===`;
            return report;
        }

        btnAudit.addEventListener('click', function() {
            const input = inputData.value.trim();
            
            if (!input) {
                showMessage('请输入交易数据', 'error');
                return;
            }

            const auditResult = auditTransaction(input);
            
            if (auditResult.status === 'ERROR') {
                scoreDisplay.textContent = '--';
                scoreDisplay.style.color = '#da3633';
                scoreStatus.textContent = auditResult.statusText;
                showMessage('格式无法解析，请检查输入是否包含地址或交易方法', 'error');
                
                statusIcons.forEach(icon => {
                    icon.className = 'status-icon';
                });
                
                riskItems.forEach(item => {
                    item.style.color = '#8b949e';
                });
                
                gasValues.forEach(value => {
                    value.textContent = '--';
                });
                
                btnCopy.disabled = true;
                btnSnapshot.disabled = true;
                auditPanel.classList.remove('danger-border');
                lastAuditResult = null;
                
                window.location.hash = '';
                return;
            }

            lastAuditResult = auditResult;
            localStorage.setItem('lastAuditInput', input);
            btnCopy.disabled = false;
            btnSnapshot.disabled = false;

            scoreDisplay.textContent = auditResult.score;
            if (auditResult.score >= 80) {
                scoreDisplay.style.color = '#238636';
            } else if (auditResult.score >= 60) {
                scoreDisplay.style.color = '#d29922';
            } else {
                scoreDisplay.style.color = '#da3633';
            }
            scoreStatus.textContent = auditResult.statusText;

            statusIcons.forEach((icon, index) => {
                icon.className = 'status-icon status-' + auditResult.checks[index].status;
            });

            riskItems.forEach((item, index) => {
                const check = auditResult.checks[index];
                if (check.status === 'safe') {
                    item.style.color = '#238636';
                } else if (check.status === 'warning') {
                    item.style.color = '#d29922';
                } else {
                    item.style.color = '#da3633';
                }
            });

            if (auditResult.gas) {
                gasValues[0].textContent = auditResult.gas.gas.toLocaleString();
                gasValues[1].textContent = auditResult.gas.price || '--';
                gasValues[2].textContent = auditResult.gas.total || '--';
            }

            if (auditResult.hasExtremeRisk || auditResult.score < 40) {
                auditPanel.classList.add('danger-border');
            } else {
                auditPanel.classList.remove('danger-border');
            }

            const encodedInput = btoa(encodeURIComponent(input));
            window.location.hash = 'data=' + encodedInput;

            if (auditResult.warnings.length > 0) {
                showMessage('检测到风险项，请查看详细报告', 'error');
            }
        });

        btnReset.addEventListener('click', function() {
            inputData.value = '';
            localStorage.removeItem('lastAuditInput');
            scoreDisplay.textContent = '--';
            scoreDisplay.style.color = '#238636';
            scoreStatus.textContent = '等待审计';
            
            statusIcons.forEach(icon => {
                icon.className = 'status-icon';
            });

            riskItems.forEach(item => {
                item.style.color = '#c9d1d9';
            });

            gasValues.forEach(value => {
                value.textContent = '--';
            });
            
            btnCopy.disabled = true;
            btnSnapshot.disabled = true;
            auditPanel.classList.remove('danger-border');
            lastAuditResult = null;
            
            window.location.hash = '';
        });

        btnCopy.addEventListener('click', async function() {
            if (!lastAuditResult) return;
            
            const report = generateAuditReport(lastAuditResult);
            
            try {
                await navigator.clipboard.writeText(report);
                btnCopy.textContent = '已复制';
                btnCopy.classList.add('copied');
                showMessage('审计报告已复制到剪贴板', 'success');
                
                setTimeout(() => {
                    btnCopy.textContent = '复制审计报告';
                    btnCopy.classList.remove('copied');
                }, 2000);
            } catch (err) {
                showMessage('复制失败，请手动复制', 'error');
            }
        });

        function generateMarkdownSnapshot(result) {
            let markdown = `# CryptoAgent Guard 审计快照\n\n`;
            markdown += `## 基本信息\n\n`;
            markdown += `- **审计状态**: \`${result.status}\` (${result.statusText})\n`;
            markdown += `- **安全评分**: \`${result.score}/100\`\n`;
            markdown += `- **交易类型**: ${result.gas ? result.gas.operation : '未知'}\n`;
            
            if (result.hasExtremeRisk) {
                markdown += `\n## ⚠️ 极端风险警告\n\n`;
                markdown += `> ${result.extremeRiskReason}\n`;
            }
            
            markdown += `\n## 风险检测结果\n\n`;
            markdown += `| 检测项 | 状态 | 详情 |\n`;
            markdown += `|--------|------|------|\n`;
            result.checks.forEach(check => {
                const statusEmoji = check.status === 'safe' ? '✅' : check.status === 'warning' ? '⚠️' : '🔴';
                markdown += `| ${check.name} | ${statusEmoji} ${check.status.toUpperCase()} | ${check.message || '通过'} |\n`;
            });
            
            if (result.warnings.length > 0) {
                markdown += `\n## 🚨 风险警告列表\n\n`;
                result.warnings.forEach((warning, index) => {
                    markdown += `${index + 1}. ${warning}\n`;
                });
            }
            
            if (result.recommendations.length > 0) {
                markdown += `\n## 💡 安全建议\n\n`;
                result.recommendations.forEach((rec, index) => {
                    markdown += `${index + 1}. ${rec}\n`;
                });
            }
            
            if (result.gas) {
                markdown += `\n## ⛽ Gas 预估\n\n`;
                markdown += `- **预估 Gas**: ${result.gas.gas.toLocaleString()}\n`;
                markdown += `- **Gas 价格**: ${result.gas.price}\n`;
                markdown += `- **总费用**: ${result.gas.total}\n`;
            }
            
            markdown += `\n---\n`;
            markdown += `*报告由 CryptoAgent Guard 生成 | 所有计算均在本地完成*\n`;
            
            return markdown;
        }

        btnSnapshot.addEventListener('click', async function() {
            if (!lastAuditResult) return;
            
            const markdown = generateMarkdownSnapshot(lastAuditResult);
            
            try {
                await navigator.clipboard.writeText(markdown);
                btnSnapshot.textContent = '已导出';
                btnSnapshot.classList.add('snapshotted');
                showMessage('Markdown 审计快照已复制到剪贴板', 'success');
                
                setTimeout(() => {
                    btnSnapshot.textContent = '生成审计快照';
                    btnSnapshot.classList.remove('snapshotted');
                }, 2000);
            } catch (err) {
                showMessage('导出失败，请手动复制', 'error');
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            const defaultInput = `{"chainId": 1, "to": "0x1f9840a85d5af5bf1d1762f925bdaddc4201f984", "value": "0", "data": "0x095ea7b30000000000000000000000007a250d5630b4cf539739df2c5dacb4c659f2488d0000000000000000000000000000000000000000000000000de0b6b3a7640000", "method": "approve"}`;
            
            let inputValue = defaultInput;
            const hash = window.location.hash;
            
            if (hash.startsWith('#data=')) {
                try {
                    const encodedData = hash.substring(6);
                    inputValue = decodeURIComponent(atob(encodedData));
                } catch (e) {
                    console.warn('Failed to decode hash data:', e);
                }
            } else {
                const savedInput = localStorage.getItem('lastAuditInput');
                if (savedInput) {
                    inputValue = savedInput;
                }
            }
            
            inputData.value = inputValue;
            inputData.focus();
            
            if (hash.startsWith('#data=') || localStorage.getItem('lastAuditInput')) {
                setTimeout(() => {
                    btnAudit.click();
                }, 100);
            }
        });
    </script>
</body>
</html>